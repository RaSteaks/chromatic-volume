{
  "rewrites": [
    { "source": "/preview", "destination": "/preview/index.html" },
    { "source": "/preview/", "destination": "/preview/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https: http:"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
